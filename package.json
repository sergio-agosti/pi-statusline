{
  "name": "pi-statusline",
  "version": "1.0.0",
  "description": "A pi-deck style status line for pi that also renders the status entries other extensions publish with ctx.ui.setStatus().",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "statusline",
    "status"
  ],
  "license": "MIT",
  "author": "Sergio Agosti",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
